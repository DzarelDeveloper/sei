{
  "name": "sei",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SEI — Self Exploration Intelligence. Web app yang membantu siswa SMP, SMA, dan SMK mengenali minat dan menjelajahi pilihan pendidikan.",
  "homepage": "https://sei-dzarel.netlify.app",
